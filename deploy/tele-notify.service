# systemd *user* service for tele-notify (issue #6).
#
# Installed by deploy/install.sh (no sudo). Then, once:
#   telenotify login                      # your Telegram login
#   systemctl --user enable --now tele-notify
#   loginctl enable-linger "$USER"        # keep it running when you're logged out
#
# Config: ~/.config/tele-notify/config.json. Logs: journalctl --user -u tele-notify -f

[Unit]
Description=tele-notify: forwards matching Telegram job posts
Wants=network-online.target
After=network-online.target

[Service]
WorkingDirectory=%h
ExecStart=%h/.local/bin/telenotify run
Restart=always
RestartSec=30
# be a good neighbour
Nice=5
MemoryMax=2G

[Install]
WantedBy=default.target
